# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Model weights & checkpoints ---
# Keep these on Spark/Octopus, never in git. v1 on Octopus is 4.9 GB of these.
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
# ONNX puts weights in a sidecar next to the graph; that is the 90 MB half.
*.onnx.data
*.npz
checkpoints/
artifacts/

# --- Training / eval outputs ---
runs/
outputs/
reports/
tensorboard/
events.out.tfevents.*
wandb/
slurm-*.out
*.sbatch.log

# --- Rendered audio ---
# Audition packs are regenerated by the eval pipeline; do not commit WAVs.
*.wav
*.flac
*.mp3
*.ogg
*.aif
*.aiff

# --- Secrets & local env ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.yaml

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# --- LaTeX build artifacts (docs/paper) ---
# The built PDF is committed so README links resolve without a TeX install;
# everything pdflatex/bibtex generate alongside it is not.
*.aux
*.bbl
*.blg
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.toc
docs/paper/*.log

# --- Explicitly kept (evidence cited by the v5 handoff doc) ---
!docs/assets/**
!docs/evidence/**

# local CPU deployment: model weights and its virtualenv
local-model/
.venv-local/

# electron shell: dependencies, build output, and the machine-specific root
electron/node_modules/
electron/dist/
electron/config.json

# --- plugin third-party ---
# JUCE is a submodule; ONNX Runtime is a 158 MB prebuilt drop fetched by
# plugin/tools/fetch_onnxruntime.sh, so neither belongs in the tree.
plugin/third_party/onnxruntime/

# --- plugin dependencies, fetched not committed ---
# ONNX Runtime comes down from the GitHub release; tools/fetch_onnxruntime.sh
# gets the right one for the platform, and it is far too large to carry here.
plugin/third_party/ort-*.tgz
plugin/third_party/onnxruntime/

# Device-authorisation leftovers. A QR for a login flow is single-use and
# belongs to whoever ran it, not to the repository.
lark-auth-qr.png
